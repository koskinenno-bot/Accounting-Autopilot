# Kopioi .env-tiedostoksi. JWT_SECRET ja SERVICE_TOKEN on oltava SAMAT kaikissa palveluissa.
PORT=3008
DATABASE_URL="postgresql://admin:password@localhost:5432/notification_service?schema=public"
REDIS_URL=redis://localhost:6379
JWT_SECRET="vaihda-pitka-satunnainen-arvo"
SERVICE_TOKEN="vaihda-pitka-satunnainen-arvo"

# Sähköposti (SMTP). Ilman SMTP_HOSTia viestit tallennetaan kansioon outbox/ eikä mitään lähetetä.
# Testaukseen käy esim. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=oma@gmail.com,
# SMTP_PASS=<sovellussalasana> (Google-tili > Tietoturva > Sovellussalasanat; vaatii kaksivaiheisen tunnistuksen).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Taloyhtiön kirjanpito <noreply@oma-domain.fi>"
MAIL_REPLY_TO=
PRODUCT_NAME="Taloyhtiön kirjanpito"
