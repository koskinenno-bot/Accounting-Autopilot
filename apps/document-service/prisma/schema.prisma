datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Oma client per palvelu: muuten kaikki palvelut generoivat saman node_modules/@prisma/clientin ja viimeisin ylikirjoittaa muut
  output   = "./client"
}

enum DocumentType {
  PROTOCOL
  REPORT
  CONTRACT
  INVOICE
  OTHER
}

model Document {
  id            String         @id @default(uuid())
  companyId     String
  name          String
  type          DocumentType   @default(OTHER)
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?
  retentionUntil DateTime?      // Säilytysaika (KPL 2:10 §: tilinpäätös ja kirjanpitokirjat 10 v tilikauden päättymisestä)
  // Automaattisen arkistoinnin tunniste, esim. "closing:<tilikausi>:package" (sama aineisto arkistoidaan vain kerran)
  sourceKey     String?
  
  versions      DocumentVersion[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
  @@index([type])
  @@unique([companyId, sourceKey])
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int      @default(1)
  filename    String
  mimeType    String
  size        Int
  storagePath String   // Path in local storage or S3 key
  checksum    String   // SHA-256 for integrity
  
  createdBy   String
  createdAt   DateTime @default(now())
  
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
