// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  role          String    @default("VIEWER")
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  isActive      Boolean   @default(true)
  // Kasvatetaan salasanan vaihdossa ja "kirjaudu ulos kaikkialta" -toiminnossa: vanhat tunnisteet lakkaavat toimimasta
  tokenVersion  Int       @default(0)
  // Kirjautumisyritysten rajoitus (tunnuksen lukitus)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  companies     UserCompany[]
  sessions      Session[]
  organizations OrganizationMember[]
}

// Isännöintitoimisto: tuotteen asiakas. Toimistolla on yhtiöt (As Oy, KOY) ja työntekijät.
model Organization {
  id          String   @id @default(uuid())
  name        String
  businessId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     OrganizationMember[]
  companies   Company[]
  invitations Invitation[]
}

// Toimiston jäsen. role: OWNER (omistaja) | ADMIN (pääkäyttäjä) | MEMBER (työntekijä).
// OWNER ja ADMIN näkevät kaikki toimiston yhtiöt isännöitsijän oikeuksin ja hallitsevat käyttäjiä.
model OrganizationMember {
  userId         String
  organizationId String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@id([userId, organizationId])
  @@index([organizationId])
}

// Kutsu toimistoon tai yksittäisiin yhtiöihin (esim. hallituksen jäsen, tilintarkastaja).
model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  orgRole        String?      // null = ei toimiston jäsen, vain yhtiökohtaiset oikeudet
  companyRoles   Json         // [{ companyId, role }]
  token          String       @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId])
}

model Company {
  id                      String    @id @default(uuid())
  businessId              String    @unique // Y-tunnus
  name                    String
  housingCooperativeId    String?   // Yhtiön tunnus
  fiscalYearStart         DateTime
  fiscalYearEnd           DateTime
  chartOfAccountsTemplate String    @default("TATO")
  companyType             String    @default("AS_OY") // AS_OY | KOY
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
  settings                Json?     // Changed to Json for PostgreSQL
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  users                   UserCompany[]
  shareholders            Shareholder[]
}

// Yhtiökohtainen käyttöoikeus. role: MANAGER (isännöitsijä) | ASSISTANT (kirjanpitoassistentti)
// | BOARD (hallitus, luku) | AUDITOR (tilin- tai toiminnantarkastaja, luku).
model UserCompany {
  userId    String
  companyId String
  role      String    @default("MANAGER")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@id([userId, companyId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Shareholder {
  id          String   @id @default(uuid())
  companyId   String
  personType  String   // 'individual' or 'company'
  firstName   String?
  lastName    String?
  companyName String?
  personalId  String?
  businessId  String?
  email       String
  phone       String?
  address     Json?
  userId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  shares      Share[]
}

model Share {
  id                  String      @id @default(uuid())
  shareholderId       String
  shareNumbers        String[]    // PostgreSQL array of strings e.g. ["1-100"]
  apartment           Json        // Contains number, address, floor, rooms, squareMeters, shareOfCommonExpenses
  ownershipStart      DateTime
  ownershipEnd        DateTime?
  ownershipPercentage Decimal     @db.Decimal(5, 4) @default(1.0000)

  shareholder         Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
}

/// Salasanan palautuslinkki. Tietokantaan tallennetaan vain tunnisteen SHA-256-tiiviste; linkki on voimassa tunnin
/// ja kertakäyttöinen.
model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
