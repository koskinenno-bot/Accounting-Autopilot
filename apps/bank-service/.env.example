# Kopioi .env-tiedostoksi. JWT_SECRET ja SERVICE_TOKEN on oltava SAMAT kaikissa palveluissa.
PORT=3005
KAFKA_BROKERS=localhost:9092
JWT_SECRET="vaihda-pitka-satunnainen-arvo"
SERVICE_TOKEN="vaihda-pitka-satunnainen-arvo"
DATABASE_URL="postgresql://admin:password@localhost:5432/bank_service?schema=public"
AUDIT_SERVICE_URL="http://localhost:3009/api/v1"
USER_SERVICE_URL="http://localhost:3001/api/v1"
# Pankkiyhteys (Enable Banking): pudota <sovellustunnus>.pem kansioon salaiset/, muuta ei tarvita.
# ENABLE_BANKING_KEY_PATH=
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_REDIRECT_URL=http://localhost:5173/bank-connections/callback
# ENABLE_BANKING_SYNC_HOURS=6
