// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum EntryStatus {
  DRAFT
  POSTED
  LOCKED
}

model Account {
  id            String    @id @default(uuid())
  companyId     String
  accountNumber String
  accountName   String
  accountType   AccountType
  parentAccount String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines         AccountingLine[]

  @@unique([companyId, accountNumber])
}

model FiscalYear {
  id            String    @id @default(uuid())
  companyId     String
  startDate     DateTime
  endDate       DateTime
  status        FiscalYearStatus @default(OPEN)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries       AccountingEntry[]

  @@unique([companyId, startDate, endDate])
}

model AccountingEntry {
  id            String    @id @default(uuid())
  companyId     String
  fiscalYearId  String?
  entryDate     DateTime
  voucherNumber String
  voucherId     String?   // External ID for Document Service
  description   String?
  status        EntryStatus @default(DRAFT)
  postedBy      String?
  postedAt      DateTime?
  lockedAt      DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  version       Int?      @default(1)
  // Automaation käsittelytiedot (Käsittelemättömät-näkymä)
  counterparty   String?            // toimittaja / maksaja (oppiminen: toimittaja -> tili)
  autoApprovable Boolean  @default(false) // tekoäly varma => "Hyväksy kaikki varmat"
  needsVoucher   Boolean  @default(false) // pankkimeno ilman tositetta (KPL 2:5 §)
  voucherRequestedAt   DateTime? // puuttuvaa tositetta pyydetty sähköpostilla
  voucherRequestedFrom String?
  reviewNote     String?
  // NORMAL | OPENING (avaus) | CLOSING (tuloksen siirto, ei tuloslaskelmaan) | ACCRUAL (jaksotus)
  // | ACCRUAL_REVERSAL (jaksotuksen purku) | DEPRECIATION (poisto)
  entryType      String   @default("NORMAL")
  fixedAssetId   String?

  fiscalYear    FiscalYear? @relation(fields: [fiscalYearId], references: [id])
  lines         AccountingLine[]

  @@unique([companyId, voucherNumber])
}

enum PurchaseInvoiceStatus {
  PROPOSED // kirjausluonnos tehty
  BOOKED   // kuluvienti hyväksytty (ostovelka)
  PAID     // maksu täsmätty pankista
}

/// Ostolasku tositteesta (suoriteperuste: kulu ja ostovelka laskun päivälle).
model PurchaseInvoice {
  id                 String   @id @default(uuid())
  companyId          String
  voucherId          String?
  supplierName       String
  supplierBusinessId String?
  supplierKey        String   // Y-tunnus tai normalisoitu nimi: tuplien esto ja oppiminen
  invoiceNumber      String?
  invoiceDate        DateTime
  dueDate            DateTime?
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?
  totalAmount        Decimal  @db.Decimal(15, 2)
  vatAmount          Decimal? @db.Decimal(15, 2)
  referenceNumber    String?
  iban               String?
  expenseAccount     String
  confidence         Float    @default(0)
  extractor          String?
  status             PurchaseInvoiceStatus @default(PROPOSED)
  accountingEntryId  String?
  paymentEntryId     String?
  /// Hyväksyntäkierto: PENDING, APPROVED tai REJECTED (ks. src/payments.ts approvalState)
  approvalStatus     String   @default("PENDING")
  rejectionReason    String?
  /// Maksuerä, johon lasku on otettu (sama lasku ei voi olla kahdessa erässä)
  paymentBatchId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  approvals          PurchaseApproval[]

  @@unique([companyId, supplierKey, invoiceNumber])
  @@index([companyId, status])
}

/// Ostolaskun hyväksyntä tai hylkäys (kuka, millä roolilla, milloin).
model PurchaseApproval {
  id         String          @id @default(uuid())
  invoiceId  String
  userId     String
  /// Yhtiörooli hyväksyntähetkellä: MANAGER, ASSISTANT tai BOARD
  role       String
  /// APPROVE tai REJECT
  decision   String
  comment    String?
  createdAt  DateTime        @default(now())

  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, userId])
}

/// Yhtiön hyväksyntäsääntö: rajan ylittävät laskut vaativat lisäksi hallituksen jäsenen hyväksynnän.
model ApprovalPolicy {
  companyId  String   @id
  boardLimit Decimal? @db.Decimal(15, 2)
  /// Maksajan tili maksuaineistoon
  debtorIban String?
  debtorBic  String?
  updatedAt  DateTime @updatedAt
}

/// Maksuaineisto (SEPA pain.001), jonka isännöitsijä lähettää verkkopankkiin.
model PaymentBatch {
  id            String   @id @default(uuid())
  companyId     String
  messageId     String   @unique
  executionDate DateTime
  debtorName    String
  debtorIban    String
  debtorBic     String?
  totalAmount   Decimal  @db.Decimal(15, 2)
  count         Int
  /// CREATED = ladattavissa, SENT = merkitty lähetetyksi pankkiin, CANCELLED = peruttu (laskut vapautuvat)
  status        String   @default("CREATED")
  xml           String
  createdBy     String?
  createdAt     DateTime @default(now())
  sentAt        DateTime?

  @@index([companyId])
}

/// Käyttöomaisuus (esim. rakennus 1010) ja sen poistosuunnitelma.
model FixedAsset {
  id                     String   @id @default(uuid())
  companyId              String
  name                   String
  accountNumber          String   // taseen tili, jolta poisto vähennetään (1010 Rakennukset)
  acquisitionDate        DateTime
  acquisitionCost        Decimal  @db.Decimal(15, 2)
  // Ennen järjestelmän käyttöönottoa kertyneet poistot (avaava kirjanpitoarvo = hankintameno - tämä)
  priorDepreciation      Decimal  @db.Decimal(15, 2) @default(0)
  // DECLINING = menojäännös % / STRAIGHT_LINE = tasapoisto vuosina / MANUAL = summa käsin
  // (taloyhtiössä poisto vastaa usein lainanlyhennyksiä)
  method                 String
  rate                   Decimal? @db.Decimal(5, 2)  // menojäännöspoiston %
  usefulLifeYears        Int?
  manualAmount           Decimal? @db.Decimal(15, 2)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
}

/// Käyttäjän korjauksista opittu tiliöinti: toimittaja -> tili (yhtiökohtainen).
model SupplierAccountRule {
  id            String   @id @default(uuid())
  companyId     String
  supplierKey   String
  supplierName  String
  accountNumber String
  timesUsed     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, supplierKey])
}

model AccountingLine {
  id            String    @id @default(uuid())
  entryId       String
  accountNumber String
  companyId     String    // Required for composite relation with Account
  debit         Decimal   @db.Decimal(15, 2) @default(0)
  credit        Decimal   @db.Decimal(15, 2) @default(0)
  description   String?
  costCenter    String?
  project       String?
  vatCode       String?
  vatAmount     Decimal?  @db.Decimal(15, 2)

  entry         AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [companyId, accountNumber], references: [companyId, accountNumber])
}

// Poikkeusjonon tehtävän tila: kenelle se on annettu ja milloin siitä muistutetaan.
// Itse tehtävät lasketaan kirjanpidosta (ks. src/queue.ts); tämä tallentaa vain ihmisen päätökset.
model QueueTask {
  id           String    @id @default(uuid())
  companyId    String
  itemKey      String    // esim. "entry:<id>", "voucher:<id>", "invoice:<id>", "closing:<id>", "bank", "auto"
  assignedTo   String?   // user-servicen käyttäjä
  assignedBy   String?
  snoozedUntil DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@unique([companyId, itemKey])
  @@index([assignedTo])
}

/// Tilinpäätöksen tekstiosat tilikausittain: toimintakertomus, liitetiedot, tase-erittelyjen selitteet ja
/// allekirjoittajat. Tyhjä osio = käytetään raportointipalvelun automaattista tekstiä.
model ClosingPackage {
  fiscalYearId   String    @id
  companyId      String
  report         Json?     // toimintakertomus { osio: teksti }
  notes          Json?     // liitetiedot { osio: teksti }
  balanceNotes   Json?     // tase-erittelyt { tili: selite }
  signers        Json?     // [{ name, role }]
  signPlace      String?
  signDate       DateTime?
  auditorName    String?
  auditorKind    String?   // AUDITOR = tilintarkastaja | INSPECTOR = toiminnantarkastaja
  signedAt       DateTime? // allekirjoitettu: tekstit lukitaan
  updatedBy      String?
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

/// Talousarvio: tilikohtainen arvio luonnollisella etumerkillä (tuotot ja kulut positiivisina).
model BudgetLine {
  id             String   @id @default(uuid())
  companyId      String
  fiscalYearId   String
  accountNumber  String
  amount         Decimal  @db.Decimal(15, 2)
  updatedAt      DateTime @updatedAt

  @@unique([fiscalYearId, accountNumber])
  @@index([companyId])
}

/// Vanhan kirjanpitojärjestelmän tilin vastine yhtiön tilikartassa (siirto vanhasta, moduuli 11).
model AccountMapping {
  id             String   @id @default(uuid())
  companyId      String
  sourceAccount  String
  sourceName     String?
  targetAccount  String
  updatedAt      DateTime @updatedAt

  @@unique([companyId, sourceAccount])
}

/// Arvonlisäverotus: yhtiö (yleensä KOY) on hakeutunut verovelvolliseksi kiinteistön käyttöoikeuden luovutuksesta.
model VatSettings {
  companyId        String   @id
  registered       Boolean  @default(false)
  /// MONTH, QUARTER tai YEAR (verokauden pituus)
  period           String   @default("MONTH")
  /// Yhteisten kulujen vähennysoikeus prosentteina (osittain verollinen käyttö), 0–100
  deductionPercent Decimal  @db.Decimal(5, 2) @default(100)
  registeredFrom   DateTime?
  businessId       String?
  contactPhone     String?
  updatedBy        String?
  updatedAt        DateTime @updatedAt
}

/// Palkanmaksun asetukset (moduuli 9). Prosentit; tyelTotal sisältää työntekijän osuuden.
model PayrollSettings {
  companyId            String   @id
  tyelTotal            Decimal  @db.Decimal(5, 2) @default(25.85)
  tyelEmployee         Decimal  @db.Decimal(5, 2) @default(7.30)
  unemploymentEmployer Decimal  @db.Decimal(5, 2) @default(0.31)
  unemploymentEmployee Decimal  @db.Decimal(5, 2) @default(0.89)
  healthEmployer       Decimal  @db.Decimal(5, 2) @default(1.91)
  accident             Decimal  @db.Decimal(5, 2) @default(0)
  tyelInsurer          String?
  tyelPolicy           String?
  updatedBy            String?
  updatedAt            DateTime @updatedAt
}

/// Palkan tai palkkion saaja (hallituksen jäsen, talonmies). Henkilötunnus tulorekisteri-ilmoitusta varten.
model Payee {
  id                   String   @id @default(uuid())
  companyId            String
  name                 String
  hetu                 String?
  iban                 String?
  role                 String?
  /// Verokortti: perusprosentti, lisäprosentti ja tuloraja (vuodelle taxCardYear). Tyhjä = ei verokorttia (60 %).
  taxPercent           Decimal? @db.Decimal(5, 2)
  taxAdditionalPercent Decimal? @db.Decimal(5, 2)
  taxIncomeLimit       Decimal? @db.Decimal(15, 2)
  taxCardYear          Int?
  defaultIncomeType    String   @default("210")
  defaultAmount        Decimal? @db.Decimal(15, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items                PayrollItem[]

  @@index([companyId])
}

/// Palkanmaksu (yksi maksupäivä). DRAFT → POSTED (kirjanpitovienti tehty, laskelma lukittu).
model PayrollRun {
  id                String    @id @default(uuid())
  companyId         String
  number            Int
  payDate           DateTime
  periodStart       DateTime
  periodEnd         DateTime
  description       String
  status            String    @default("DRAFT")
  accountingEntryId String?
  /// Lukittu laskelma kirjaushetkellä (summat ja palkansaajakohtaiset erät)
  result            Json?
  wageReportedAt    DateTime?
  wageReportedBy    String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  postedAt          DateTime?
  postedBy          String?

  items             PayrollItem[]

  @@unique([companyId, number])
  @@index([companyId, payDate])
}

model PayrollItem {
  id          String     @id @default(uuid())
  runId       String
  payeeId     String
  incomeType  String
  amount      Decimal    @db.Decimal(15, 2)
  description String?

  run         PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  payee       Payee      @relation(fields: [payeeId], references: [id])

  @@index([runId])
}

/// Rakennusurakka, josta annetaan urakkatiedot Verohallinnolle (arvo yli 15 000 € alv 0).
model ConstructionContract {
  id                   String    @id @default(uuid())
  companyId            String
  contractorName       String
  contractorBusinessId String
  siteName             String
  siteAddress          String?
  description          String?
  value                Decimal   @db.Decimal(15, 2)
  /// URAKKA tai TUNTI
  billingBasis         String    @default("URAKKA")
  startDate            DateTime
  endDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId])
}

/// Merkintä annetusta ilmoituksesta: EMPLOYER (erillisilmoitus, avain 2026-11) tai CONTRACTS (urakkatiedot, 2026-11).
model ReportMark {
  id         String   @id @default(uuid())
  companyId  String
  kind       String
  key        String
  reportedAt DateTime @default(now())
  reportedBy String?

  @@unique([companyId, kind, key])
}

/// Pankkitilin saldo päivältä (PSD2-haku, camt.053-tiliotteen loppusaldo tai käsin syötetty). Pankkitäsmäytys.
model BankBalance {
  id        String   @id @default(uuid())
  companyId String
  iban      String
  date      DateTime
  balance   Decimal  @db.Decimal(15, 2)
  /// PSD2, CAMT tai MANUAL
  source    String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([companyId, iban, date])
  @@index([companyId, date])
}

/// Ajankäyttö yhtiöittäin (tavoite: alle 10 h ihmistyötä yhtiötä kohden vuodessa).
/// Automaattinen: dashboard lähettää minuutin välein merkin, kun käyttäjä työskentelee yhtiön sivuilla.
model ActiveTime {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  day       DateTime @db.Date
  minutes   Int      @default(0)
  lastBeat  DateTime
  @@unique([companyId, userId, day])
  @@index([companyId, day])
}

/// Käsin kirjattu työaika (esim. puhelut, kokoukset ja muu työ ohjelman ulkopuolella).
model TimeEntry {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  day       DateTime @db.Date
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
  @@index([companyId, day])
}
