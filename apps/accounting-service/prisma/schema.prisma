// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum EntryStatus {
  DRAFT
  POSTED
  LOCKED
}

model Account {
  id            String    @id @default(uuid())
  companyId     String
  accountNumber String
  accountName   String
  accountType   AccountType
  parentAccount String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines         AccountingLine[]

  @@unique([companyId, accountNumber])
}

model FiscalYear {
  id            String    @id @default(uuid())
  companyId     String
  startDate     DateTime
  endDate       DateTime
  status        FiscalYearStatus @default(OPEN)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries       AccountingEntry[]

  @@unique([companyId, startDate, endDate])
}

model AccountingEntry {
  id            String    @id @default(uuid())
  companyId     String
  fiscalYearId  String?
  entryDate     DateTime
  voucherNumber String
  voucherId     String?   // External ID for Document Service
  description   String?
  status        EntryStatus @default(DRAFT)
  postedBy      String?
  postedAt      DateTime?
  lockedAt      DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  version       Int?      @default(1)
  // Automaation käsittelytiedot (Käsittelemättömät-näkymä)
  counterparty   String?            // toimittaja / maksaja (oppiminen: toimittaja -> tili)
  autoApprovable Boolean  @default(false) // tekoäly varma => "Hyväksy kaikki varmat"
  needsVoucher   Boolean  @default(false) // pankkimeno ilman tositetta (KPL 2:5 §)
  reviewNote     String?
  // NORMAL | OPENING (avaus) | CLOSING (tuloksen siirto, ei tuloslaskelmaan) | ACCRUAL (jaksotus)
  // | ACCRUAL_REVERSAL (jaksotuksen purku) | DEPRECIATION (poisto)
  entryType      String   @default("NORMAL")
  fixedAssetId   String?

  fiscalYear    FiscalYear? @relation(fields: [fiscalYearId], references: [id])
  lines         AccountingLine[]

  @@unique([companyId, voucherNumber])
}

enum PurchaseInvoiceStatus {
  PROPOSED // kirjausluonnos tehty
  BOOKED   // kuluvienti hyväksytty (ostovelka)
  PAID     // maksu täsmätty pankista
}

/// Ostolasku tositteesta (suoriteperuste: kulu ja ostovelka laskun päivälle).
model PurchaseInvoice {
  id                 String   @id @default(uuid())
  companyId          String
  voucherId          String?
  supplierName       String
  supplierBusinessId String?
  supplierKey        String   // Y-tunnus tai normalisoitu nimi: tuplien esto ja oppiminen
  invoiceNumber      String?
  invoiceDate        DateTime
  dueDate            DateTime?
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?
  totalAmount        Decimal  @db.Decimal(15, 2)
  vatAmount          Decimal? @db.Decimal(15, 2)
  referenceNumber    String?
  iban               String?
  expenseAccount     String
  confidence         Float    @default(0)
  extractor          String?
  status             PurchaseInvoiceStatus @default(PROPOSED)
  accountingEntryId  String?
  paymentEntryId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, supplierKey, invoiceNumber])
  @@index([companyId, status])
}

/// Käyttöomaisuus (esim. rakennus 1010) ja sen poistosuunnitelma.
model FixedAsset {
  id                     String   @id @default(uuid())
  companyId              String
  name                   String
  accountNumber          String   // taseen tili, jolta poisto vähennetään (1010 Rakennukset)
  acquisitionDate        DateTime
  acquisitionCost        Decimal  @db.Decimal(15, 2)
  // Ennen järjestelmän käyttöönottoa kertyneet poistot (avaava kirjanpitoarvo = hankintameno - tämä)
  priorDepreciation      Decimal  @db.Decimal(15, 2) @default(0)
  // DECLINING = menojäännös % / STRAIGHT_LINE = tasapoisto vuosina / MANUAL = summa käsin
  // (taloyhtiössä poisto vastaa usein lainanlyhennyksiä)
  method                 String
  rate                   Decimal? @db.Decimal(5, 2)  // menojäännöspoiston %
  usefulLifeYears        Int?
  manualAmount           Decimal? @db.Decimal(15, 2)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
}

/// Käyttäjän korjauksista opittu tiliöinti: toimittaja -> tili (yhtiökohtainen).
model SupplierAccountRule {
  id            String   @id @default(uuid())
  companyId     String
  supplierKey   String
  supplierName  String
  accountNumber String
  timesUsed     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, supplierKey])
}

model AccountingLine {
  id            String    @id @default(uuid())
  entryId       String
  accountNumber String
  companyId     String    // Required for composite relation with Account
  debit         Decimal   @db.Decimal(15, 2) @default(0)
  credit        Decimal   @db.Decimal(15, 2) @default(0)
  description   String?
  costCenter    String?
  project       String?
  vatCode       String?
  vatAmount     Decimal?  @db.Decimal(15, 2)

  entry         AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [companyId, accountNumber], references: [companyId, accountNumber])
}

// Poikkeusjonon tehtävän tila: kenelle se on annettu ja milloin siitä muistutetaan.
// Itse tehtävät lasketaan kirjanpidosta (ks. src/queue.ts); tämä tallentaa vain ihmisen päätökset.
model QueueTask {
  id           String    @id @default(uuid())
  companyId    String
  itemKey      String    // esim. "entry:<id>", "voucher:<id>", "invoice:<id>", "closing:<id>", "bank", "auto"
  assignedTo   String?   // user-servicen käyttäjä
  assignedBy   String?
  snoozedUntil DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@unique([companyId, itemKey])
  @@index([assignedTo])
}
